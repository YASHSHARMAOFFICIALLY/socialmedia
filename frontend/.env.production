# Public, non-secret URLs. NEXT_PUBLIC_* values are inlined by `next build`, so they must exist at build time:
# wrangler.jsonc "vars" only reach the Worker at runtime, too late for client bundles and the prerendered sitemap.
NEXT_PUBLIC_SITE_URL=https://postrally.app
NEXT_PUBLIC_API_URL=https://api.postrally.app
