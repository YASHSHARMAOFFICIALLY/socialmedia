# ---- Local development: copy to .dev.vars (read by `wrangler dev`) ----
LOG_LEVEL=debug
NODE_ENV=development
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long    # openssl rand -base64 48
BETTER_AUTH_URL=http://localhost:8787                       # public base URL of THIS API (OAuth redirect URIs derive from it)
APP_URL=http://localhost:5173                               # frontend base URL used in emailed links and OAuth return redirects
CORS_ORIGINS=http://localhost:5173                          # comma separated; also the Origin allow-list for state-changing requests
TOKEN_ENC_KEYS=1:REPLACE_BASE64_32_BYTES                    # "<id>:<base64 32 bytes>[,<oldid>:...]"; first entry encrypts. openssl rand -base64 32
RESEND_API_KEY=                                             # optional; without it emails are logged only
OPS_TOKEN=                                                  # optional (>=24 chars): enables GET /health/queues for monitors
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=                             # optional (>=16 chars): the Verify Token you configure for Instagram webhooks
ANTHROPIC_API_KEY=                                          # optional: enables AI suggestions (post text is sent to the provider)
AI_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=200                                          # AI requests per workspace per day

# Platform apps (each platform is enabled only when BOTH values are set)
THREADS_APP_ID=                                              # optional: Threads (Meta app, Threads use case)
THREADS_APP_SECRET=
FACEBOOK_APP_ID=                                             # optional: Facebook Pages publishing
FACEBOOK_APP_SECRET=
PINTEREST_APP_ID=                                            # optional
PINTEREST_APP_SECRET=
TIKTOK_CLIENT_KEY=                                           # optional (unverified adapter: see docs/integrations.md)
TIKTOK_CLIENT_SECRET=
BLUESKY_SERVICE=                                             # optional PDS URL, default https://bsky.social. Bluesky/Mastodon/Telegram need no app credentials.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_CLIENT_ID=                                           # YouTube
GOOGLE_CLIENT_SECRET=
INSTAGRAM_APP_ID=                                           # Instagram app id (Instagram API with Instagram Login), not the Facebook app id
INSTAGRAM_APP_SECRET=

# Cloudflare R2 (S3 API credentials from an R2 API token). Without these, media endpoints answer 503 MEDIA_STORAGE_NOT_CONFIGURED.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Shell environment (NOT .dev.vars) ----
# DATABASE_URL=postgres://...   direct Neon connection string, used by `npm run migrate`
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$DATABASE_URL   makes `wrangler dev` talk to that database
