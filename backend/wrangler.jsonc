{
  "name": "social-platform",
  "main": "src/entrypoints/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "NODE_ENV": "production", "LOG_LEVEL": "info", "CORS_ORIGINS": "https://socialmedia-web.yashsharmaofficially1.workers.dev" },
  // Create with: wrangler hyperdrive create social-db --connection-string="<neon DIRECT connection string>" --caching-disabled
  // Caching MUST stay off: Hyperdrive serves cached SELECTs for 60s and never invalidates them on writes, which breaks every
  // read-modify-write here (Better Auth's DB rate limiter loops until "Too many subrequests", job leases, sessions after sign-out).
  // Local dev uses CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=<postgres url>
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "5c716710e8024a0484c8aa932c5a0882" }],
  // Delivery only: Postgres (jobs + outbox) is the source of truth, the sweeper re-enqueues anything lost.
  "queues": {
    "producers": [
      { "binding": "PUBLISH_QUEUE", "queue": "publish-jobs" },
      { "binding": "ANALYTICS_QUEUE", "queue": "analytics-collect" }
    ],
    "consumers": [
      { "queue": "publish-jobs", "max_batch_size": 5, "max_batch_timeout": 2, "max_retries": 5, "dead_letter_queue": "publish-jobs-dlq" },
      { "queue": "analytics-collect", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "analytics-collect-dlq" },
      { "queue": "publish-jobs-dlq", "max_batch_size": 10 },
      { "queue": "analytics-collect-dlq", "max_batch_size": 10 }
    ]
  },
  // Optional dashboard cache (analytics responses). Create with: wrangler kv namespace create CACHE, then add { "kv_namespaces": [{ "binding": "CACHE", "id": "..." }] }
  // Outbox relay, sweeper, analytics scheduler (all idempotent; Postgres is the source of truth)
  "triggers": { "crons": ["* * * * *"] }
}
